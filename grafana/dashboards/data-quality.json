          "rawQuery": true,
          "rawSql": "SELECT\r\n    created_at AS \"time\",\r\n    COALESCE((error_counts->>'null_required_value')::int, 0)\r\n        AS \"Completeness\",\r\n    COALESCE((error_counts->>'invalid_range')::int, 0)\r\n        AS \"Validity\",\r\n    COALESCE((error_counts->>'duplicate_instant')::int, 0)\r\n        + COALESCE((error_counts->>'holiday_workingday_inconsistency')::int, 0)\r\n        AS \"Consistency\",\r\n    COALESCE((error_counts->>'missing_required_column')::int, 0)\r\n        AS \"Schema\",\r\n    COALESCE((error_counts->>'invalid_numeric_type')::int, 0)\r\n        AS \"Type\"\r\nFROM ingestion_stats\r\nWHERE $__timeFilter(created_at)\r\nORDER BY created_at;",
