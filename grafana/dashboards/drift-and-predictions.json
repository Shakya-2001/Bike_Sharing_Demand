        {
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\r\n    date_trunc('minute', created_at) AS \"time\",\r\n    model_name || ' v' || model_version AS model,\r\n    percentile_cont(0.9) WITHIN GROUP (ORDER BY prediction)\r\n        - percentile_cont(0.1) WITHIN GROUP (ORDER BY prediction)\r\n        AS \"Prediction spread\"\r\nFROM predictions\r\nWHERE $__timeFilter(created_at)\r\n    AND model_version IS NOT NULL\r\nGROUP BY 1, 2\r\nHAVING COUNT(*) >= 2\r\nORDER BY 1, 2;",
          "refId": "A",
