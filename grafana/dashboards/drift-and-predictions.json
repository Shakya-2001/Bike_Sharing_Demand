      "targets": [
        {
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH weather_shares AS (\r\n    SELECT\r\n        date_trunc('minute', p.created_at) AS \"time\",\r\n        p.model_name,\r\n        p.model_version,\r\n        weather.code,\r\n        AVG(\r\n            CASE WHEN p.features->>'weathersit' = weather.code\r\n                 THEN 1.0 ELSE 0.0 END\r\n        ) AS serving_share,\r\n        COALESCE(\r\n            MAX(\r\n                (s.categorical_stats->'weathersit'->>weather.code)\r\n                ::double precision\r\n            ),\r\n            0\r\n        ) AS training_share\r\n    FROM predictions AS p\r\n    JOIN training_stats AS s\r\n        ON s.model_name = p.model_name\r\n        AND s.model_version = p.model_version\r\n        AND s.promoted_at IS NOT NULL\r\n    CROSS JOIN (VALUES ('1'), ('2'), ('3'), ('4')) AS weather(code)\r\n    WHERE $__timeFilter(p.created_at)\r\n    GROUP BY 1, 2, 3, 4\r\n)\r\nSELECT\r\n    \"time\",\r\n    model_name || ' v' || model_version AS model,\r\n    50 * SUM(ABS(serving_share - training_share)) AS \"Weather drift (%)\"\r\nFROM weather_shares\r\nGROUP BY 1, 2\r\nORDER BY 1, 2;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Weather category drift by model version",
      "type": "timeseries"
    },
