      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bike-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\r\n    date_trunc('minute', p.created_at) AS \"time\",\r\n    p.model_name || ' v' || p.model_version AS model,\r\n    AVG((p.features->>'temp')::double precision) AS \"Serving mean\",\r\n    MAX((s.numerical_stats->'temp'->>'mean')::double precision)\r\n        AS \"Training mean\"\r\nFROM predictions AS p\r\nJOIN training_stats AS s\r\n    ON s.model_name = p.model_name\r\n    AND s.model_version = p.model_version\r\n    AND s.promoted_at IS NOT NULL\r\nWHERE $__timeFilter(p.created_at)\r\nGROUP BY 1, 2\r\nORDER BY 1, 2;",
          "refId": "A",
          "sql": {
            "columns": [
